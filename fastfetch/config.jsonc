{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "%USERPROFILE%/.config/fastfetch/ascii_mocha.txt",
        "color": {
            "1": "38;2;243;139;168",
            "2": "38;2;250;179;135",
            "3": "38;2;249;226;175",
            "4": "38;2;166;227;161",
            "5": "38;2;148;226;213",
            "6": "38;2;137;180;250",
            "7": "38;2;180;190;254",
            "8": "38;2;203;166;247",
            "9": "38;2;245;194;231"
        },
        "padding": {
            "top": 0,
            "right": 3
        }
    },
    // Logo em imagem (para voltar: apague o bloco "logo" acima e descomente este)
    // "logo": {
    //     "type": "raw",
    //     "source": "%USERPROFILE%/.config/fastfetch/logo.sixel",
    //     "width": 32,
    //     "height": 20,
    //     "padding": {
    //         "top": 1,
    //         "right": 3
    //     }
    // },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "38;2;180;190;254",
            "title": "38;2;180;190;254",
            "output": "38;2;205;214;244",
            "separator": "38;2;108;112;134"
        }
    },
    "modules": [
        {
            "key": "╭───────────╮",
            "type": "custom"
        },
        {
            "key": "│ {#38;2;243;139;168}\uf007 USER    {#keys}│",
            "type": "title",
            "format": "{user-name}"
        },
        {
            "key": "│ {#38;2;166;227;161}\uf233 HNAME   {#keys}│",
            "type": "title",
            "format": "{host-name}"
        },
        {
            "key": "│ {#38;2;137;180;250}\uf017 UPTIME  {#keys}│",
            "type": "uptime"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#38;2;148;226;213}\uf17a OS      {#keys}│",
            "type": "os"
        },
        // {
        //     "key": "│ {#38;2;249;226;175}\uf073 OS AGE  {#keys}│",
        //     "type": "command",
        //     "text": "powershell -NoProfile -EncodedCommand KAAoACgARwBlAHQALQBEAGEAdABlACkAIAAtACAAKABnAGMAaQBtACAAVwBpAG4AMwAyAF8ATwBwAGUAcgBhAHQAaQBuAGcAUwB5AHMAdABlAG0AKQAuAEkAbgBzAHQAYQBsAGwARABhAHQAZQApAC4ARABhAHkAcwApAC4AVABvAFMAdAByAGkAbgBnACgAKQAgACsAIAAnACAAZABpAGEAcwAnAA=="
        // },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#38;2;148;226;213}\uf2d0 WM      {#keys}│",
            "type": "wm",
            "format": "{plugin-name}"
        },
        {
            "key": "│ {#38;2;137;180;250}\udb80\udd8d TERMINAL{#keys}│",
            "type": "terminal"
        },
        {
            "key": "│ {#38;2;203;166;247}\uf10d FONT    {#keys}│",
            "type": "terminalfont"
        },
        {
            "key": "│ {#38;2;166;227;161}\udb82\ude0a SHELL   {#keys}│",
            "type": "shell"
        },
        {
            "key": "│ {#38;2;249;226;175}\uf0ac LOCALE  {#keys}│",
            "type": "locale"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#38;2;203;166;247}\udb81\ude97 BOARD   {#keys}│",
            "type": "board"
        },
        {
            "key": "│ {#38;2;249;226;175}\uf2db CPU     {#keys}│",
            "type": "cpu",
            "showPeCoreCount": true
        },
        {
            "key": "│ {#38;2;243;139;168}\uf1b2 GPU     {#keys}│",
            "type": "gpu",
            "format": "{name}"
        },
        // {
        //     "key": "│ {#38;2;203;166;247}\uf108 MONITOR {#keys}│",
        //     "type": "display"
        // },
        {
            "key": "│ {#38;2;148;226;213}\uf1c0 RAM     {#keys}│",
            "type": "memory"
        },
        {
            "key": "│ {#38;2;137;180;250}\uf0a0 DISK 1  {#keys}│",
            "type": "disk",
            "folders": "C:\\",
            "format": "{mountpoint} {size-used} / {size-total} ({size-percentage}) - {filesystem}"
        },
        {
            "key": "│ {#38;2;166;227;161}\uf0a0 DISK 2  {#keys}│",
            "type": "disk",
            "folders": "A:\\",
            "format": "{mountpoint} {size-used} / {size-total} ({size-percentage}) - {filesystem}"
        },
        {
            "key": "╰───────────╯",
            "type": "custom"
        }
    ]
}
