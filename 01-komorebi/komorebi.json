{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.42/schema.json",
  "app_specific_configuration_path": "$Env:USERPROFILE/applications.json",
  "window_hiding_behaviour": "Cloak",
  "cross_monitor_move_behaviour": "Insert",

  "transparency": false,
  "transparency_alpha": 252,
  "default_workspace_padding": 18,
  "default_container_padding": 8,
  "border": false,
  "border_style":"Rounded",
  "border_width": 2,
  "border_offset": 0,
  "mouse_follows_focus": false,
  "animation": {
    "enabled": false,
    "duration": 160,
    "fps": 300,
    "style": {
        "movement":"EaseInOutQuad",
        "transparency": "Linear"
      }
},
  "border_colours": {
    "single": "#b4befe",
    "unfocused": "#a1a1a1",
    "floating": "#b4befe",
    "monocle": "#b4befe"
  },
  "monitors": [
    // monitor 1, index 0
    {
      "workspaces": [
        {
          "name": "I",
          "layout": "BSP"
        },
        {
          "name": "II",
          "layout": "Grid"
        },
        {
          "name": "III",
          "layout": "BSP"
        }
      ]
    },
    // monitor 2, index 1
    {
      "workspaces": [
        {
          "name": "Home",
          "layout": "BSP"
        },
        {
          "name": "2",
          "layout": "Grid"
        },
        {
          "name": "3",
          "layout": "UltrawideVerticalStack"
        }
      ]
    }
  ],
 "ignore_rules": [
[
{ "kind": "Title", "id": "Picture-in-Picture", "matching_strategy": "Contains" },
{ "kind": "Class", "id": "Chrome_WidgetWin_1", "matching_strategy": "Equals" }
],
{
"kind": "Exe",
"id": "yasb.exe",
"matching_strategy": "Equals"
},
{
"kind": "Exe",
"id": "ACShadows.exe",
"matching_strategy": "Equals"
},
{
"kind": "Exe",
"id": "Overwatch.exe",
"matching_strategy": "Equals"
},
{
"kind": "Exe",
"id": "League of Legends.exe",
"matching_strategy": "Equals"
},
{
"kind": "Exe",
"id": "FortniteClient-Win64-Shipping.exe",
"matching_strategy": "Equals"
},
{
"kind": "Exe",
"id": "DeadByDaylight-Win64-Shipping.exe",
"matching_strategy": "Equals"
},
{
"kind": "Exe",
"id": "Marvel-Win64-Shipping.exe",
"matching_strategy": "Equals"
},
{
"kind": "Exe",
"id": "Photos.exe",
"matching_strategy": "Equals"
},
{
"kind": "Exe",
"id": "PotPlayerMini64.exe",
"matching_strategy": "Equals"
},
{
"kind": "Exe",
"id": "AmneziaVPN.exe",
"matching_strategy": "Equals"
}
]
}
